# Nunca adicione uma chave real ao Git ou ao HTML.
OPENAI_API_KEY=cole_aqui_uma_nova_chave
# Pode ser alterado para um modelo disponível no seu projeto OpenAI.
OPENAI_MODEL=gpt-5.6-luna
PORT=8000

# ---------------------------------------------------------------------------
# Autenticação e painel administrativo (/admin)
# ---------------------------------------------------------------------------
# Em produção, use valores fortes e únicos: sem ADMIN_EMAIL e ADMIN_PASSWORD
# nenhum login de administrador é aceito e o painel /admin fica inacessível.
AUTH_SECRET=gere-um-segredo-longo-e-aleatorio
ADMIN_EMAIL=admin@pipocaplay.com
ADMIN_PASSWORD=troque-esta-senha

# ---------------------------------------------------------------------------
# Banco de contas — escolha UMA opção
# ---------------------------------------------------------------------------
# As contas de clientes são criadas pela tela de cadastro e aguardam aprovação
# do administrador. A escolha do backend é automática, nesta ordem de prioridade:
#
#   1) Postgres      2) Vercel Blob      3) Redis REST      4) arquivo local
#
# Em produção (Vercel) uma das três primeiras é obrigatória: o disco das funções
# serverless é temporário e não guarda dados entre requisições.

# Opção 1 (recomendada) — Postgres. Na Vercel: Storage → Create Database →
# Neon Postgres → Connect Project. A variável abaixo é injetada automaticamente.
POSTGRES_URL=
# Aceito como alternativa (Supabase, Railway, Postgres próprio):
DATABASE_URL=

# Opção 2 — Vercel Blob privado. Storage → Create → Blob → Connect Project.
BLOB_READ_WRITE_TOKEN=
# Opcional: caminho do objeto privado que guarda as contas.
USER_STORE_BLOB_PATH=pipoca-play/users.json

# Opção 3 — Redis REST (Upstash / Vercel KV).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Opção 4 — arquivo local: apenas para desenvolvimento na sua máquina.
USER_STORE_FILE=data/users.json

# Opcional: força um backend específico (postgres, vercel-blob, redis-rest,
# arquivo-local). Útil apenas para depuração.
USER_STORE_MODE=

# ---------------------------------------------------------------------------
# Checkout e assinatura (ASAAS)
# ---------------------------------------------------------------------------
# Sem ASAAS_API_KEY o checkout responde 503 e nenhum plano pode ser assinado —
# os resultados continuam bloqueados, porque o acesso exige pagamento confirmado.
ASAAS_API_KEY=cole_aqui_a_chave_do_asaas
# Use o ambiente de testes do ASAAS antes de cobrar de verdade.
# Aceita "sandbox" ou "producao" (padrão).
ASAAS_ENVIRONMENT=sandbox
# Opcional: sobrescreve a URL base da API. Em branco, o valor vem do
# ASAAS_ENVIRONMENT (https://api.asaas.com/v3 ou https://api-sandbox.asaas.com/v3).
ASAAS_API_URL=
# Forma de pagamento oferecida na fatura: UNDEFINED deixa o cliente escolher
# entre Pix, boleto e cartão. Também aceita PIX, BOLETO ou CREDIT_CARD.
ASAAS_BILLING_TYPE=UNDEFINED
# Token do webhook. No painel do ASAAS, cadastre a URL
# https://SEU-DOMINIO/api/billing/webhook com um token de autenticação e repita
# exatamente o mesmo valor aqui. Sem ele, o webhook recusa todos os eventos.
ASAAS_WEBHOOK_TOKEN=gere-um-token-longo-e-aleatorio

# ---------------------------------------------------------------------------
# Sessão
# ---------------------------------------------------------------------------
# Validade máxima da sessão, em segundos (padrão 28800 = 8 horas). O cookie é
# sempre de sessão de navegador: sair da página exige um novo login.
SESSION_TTL_SECONDS=28800

# ---------------------------------------------------------------------------
ENVIRONMENT=production
# Opcional: habilita metadados e disponibilidade atualizada no Brasil.
TMDB_API_KEY=cole_aqui_uma_chave_tmdb
