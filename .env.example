# Nunca adicione uma chave real ao Git ou ao HTML.
OPENAI_API_KEY=cole_aqui_uma_nova_chave
# Pode ser alterado para um modelo disponível no seu projeto OpenAI.
OPENAI_MODEL=gpt-5.6-luna
PORT=8000

# ---------------------------------------------------------------------------
# Autenticação e painel administrativo (/admin)
# ---------------------------------------------------------------------------
# Em produção, use valores fortes e únicos: sem ADMIN_EMAIL e ADMIN_PASSWORD
# nenhum login de administrador é aceito e o painel /admin fica inacessível.
AUTH_SECRET=gere-um-segredo-longo-e-aleatorio
ADMIN_EMAIL=admin@pipocaplay.com
ADMIN_PASSWORD=troque-esta-senha

# ---------------------------------------------------------------------------
# Banco de contas — escolha UMA opção
# ---------------------------------------------------------------------------
# As contas de clientes são criadas pela tela de cadastro e já entram ativas; o
# acesso ao resultado é liberado pelo pagamento. A escolha do backend é
# automática, nesta ordem de prioridade:
#
#   1) Postgres      2) Vercel Blob      3) Redis REST      4) arquivo local
#
# Em produção (Vercel) uma das três primeiras é obrigatória: o disco das funções
# serverless é temporário e não guarda dados entre requisições.

# Opção 1 (recomendada) — Postgres. Na Vercel: Storage → Create Database →
# Neon Postgres → Connect Project. A variável abaixo é injetada automaticamente.
POSTGRES_URL=
# Aceito como alternativa (Supabase, Railway, Postgres próprio):
DATABASE_URL=

# Opção 2 — Vercel Blob privado. Storage → Create → Blob → Connect Project.
BLOB_READ_WRITE_TOKEN=
# Opcional: caminho do objeto privado que guarda as contas.
USER_STORE_BLOB_PATH=pipoca-play/users.json
# Opcional: objeto que guarda os pôsteres publicados na landing pelo /admin.
LANDING_STORE_BLOB_PATH=pipoca-play/landing.json

# Opção 3 — Redis REST (Upstash / Vercel KV).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Opção 4 — arquivo local: apenas para desenvolvimento na sua máquina.
USER_STORE_FILE=data/users.json
# Opcional: arquivo dos pôsteres da landing; padrão, o irmão do de contas
# (data/users-landing.json).
LANDING_STORE_FILE=

# Opcional: força um backend específico (postgres, vercel-blob, redis-rest,
# arquivo-local). Útil apenas para depuração.
USER_STORE_MODE=

# ---------------------------------------------------------------------------
# Checkout e assinaturas (Asaas)
# ---------------------------------------------------------------------------
# Sem ASAAS_API_KEY o checkout fica indisponível e nenhum cliente consegue
# assinar — as consultas continuam bloqueadas até a confirmação do pagamento.
# A chave começa com "$aact_". Entre aspas simples: o cifrão é expandido pelo
# shell. Também são aceitos ASAAS_ACCESS_TOKEN, ASAAS_API_TOKEN, ASAAS_TOKEN e
# ASAAS_KEY. Confira em /api/health qual variável o deploy encontrou.
ASAAS_API_KEY=
# sandbox | production. Em branco, o ambiente é deduzido pela própria chave.
ASAAS_ENV=production
# Mesmo token cadastrado em Asaas → Integrações → Webhooks (campo "Token de
# autenticação"). A plataforma recusa notificações com token diferente.
ASAAS_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------
# Ambiente
# ---------------------------------------------------------------------------
ENVIRONMENT=production
