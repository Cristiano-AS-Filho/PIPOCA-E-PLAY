# Nunca adicione uma chave real ao Git ou ao HTML.
OPENAI_API_KEY=cole_aqui_uma_nova_chave
# Pode ser alterado para um modelo disponível no seu projeto OpenAI.
OPENAI_MODEL=gpt-5.6-luna
PORT=8000

# Autenticação: em produção, use valores fortes e únicos.
AUTH_SECRET=gere-um-segredo-longo-e-aleatorio
ADMIN_EMAIL=admin@pipocaplay.com
ADMIN_PASSWORD=troque-esta-senha
# Contas de clientes são criadas pela tela de cadastro e aguardam aprovação do admin.
# Em desenvolvimento, os dados ficam em data/users.json.
USER_STORE_FILE=data/users.json
# Em produção serverless, conecte uma loja privada Vercel Blob ao projeto e configure o token.
# O Blob é preferencial ao Redis REST quando BLOB_READ_WRITE_TOKEN estiver presente.
BLOB_READ_WRITE_TOKEN=
# Opcional: caminho do objeto privado que guarda as contas.
USER_STORE_BLOB_PATH=pipoca-play/users.json
# Alternativa compatível com Upstash Redis REST.
KV_REST_API_URL=
KV_REST_API_TOKEN=
ENVIRONMENT=production
# Opcional: habilita metadados e disponibilidade atualizada no Brasil.
TMDB_API_KEY=cole_aqui_uma_chave_tmdb

# Cobrança (Asaas) — planos Silver/Gold/Diamante em plans.py.
# Nunca cole a chave real aqui nem em nenhum arquivo versionado.
ASAAS_API_KEY=cole_aqui_a_chave_de_producao_ou_sandbox_do_asaas
# "production" (padrão) ou "sandbox".
ASAAS_ENVIRONMENT=production
# Gere um valor aleatório (ex: openssl rand -hex 24) e configure o mesmo
# valor no painel do Asaas em Integrações > Webhooks, no campo de token.
ASAAS_WEBHOOK_TOKEN=gere-um-segredo-longo-e-aleatorio
# URL pública do seu deploy (sem barra no final), usada para montar as URLs
# de retorno do checkout. Em produção na Vercel, ex: https://seudominio.com.
# Se vazio, o servidor deduz pelo header Host da requisição.
PUBLIC_BASE_URL=
